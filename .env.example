# ──────────────────────────────────────────────────────────
# Faculty Research Portal — .env.example
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ──────────────────────────────────────────────────────────

# ─── Application ───────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1
APP_NAME="Faculty Research Portal"

# ─── Database (PostgreSQL) ─────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/faculty_research_db"
# For connection pooling (e.g. PgBouncer / Supabase):
# DIRECT_URL="postgresql://postgres:yourpassword@localhost:5432/faculty_research_db"

# ─── JWT Authentication ────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="your-super-secret-access-token-key-min-64-chars-long"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-min-64-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# ─── Cloudinary (File Uploads) ─────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs

# ─── Cookie ────────────────────────────────────────────────
COOKIE_SECRET="your-cookie-secret-key-min-32-chars"
